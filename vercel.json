{
  "rewrites": [
    { "source": "/webhooks/(.*)", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|webhooks/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/gmail/renew-watches",
      "schedule": "0 3 * * *"
    }
  ]
}
